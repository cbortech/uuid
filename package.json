{
  "name": "@cbortech/uuid",
  "version": "0.1.3",
  "description": "A modern, type-safe TypeScript library for parsing and generating UUIDs (v1-v8, v7-first; RFC 9562).",
  "keywords": [
    "uuid",
    "uuidv7",
    "rfc9562",
    "rfc4122"
  ],
  "homepage": "https://cbor.tech/uuid/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbortech/uuid.git"
  },
  "bugs": {
    "url": "https://github.com/cbortech/uuid/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Yasuhiro Kudo <ykudo@ykudo.org>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"['dist','coverage','src/__screenshots__'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\"",
    "test": "vitest run",
    "test:node": "vitest run",
    "test:chromium": "cross-env BROWSER=chromium vitest run --config vitest.browser.config.ts",
    "test:firefox": "cross-env BROWSER=firefox vitest run --config vitest.browser.config.ts",
    "test:webkit": "cross-env BROWSER=webkit vitest run --config vitest.browser.config.ts",
    "test:all": "npm run test:node && npm run test:chromium && npm run test:firefox && npm run test:webkit",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "cross-env": "^10.1.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10"
  }
}
